<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% set pageTitle = title ~ " — " ~ site.name if title else site.name %}
  {% set pageDescription = description or site.description %}
  {% set canonicalUrl = site.url ~ page.url %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonicalUrl }}">

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="{{ pageType or "website" }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  {% if pageType == "article" and date %}
  <meta property="article:published_time" content="{{ date | isoDate }}">
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": {{ (site.url ~ "/#website") | dump | safe }},
        "url": {{ (site.url ~ "/") | dump | safe }},
        "name": {{ site.name | dump | safe }},
        "description": {{ site.description | dump | safe }},
        "inLanguage": "en"
      },
      {
        "@type": {% if pageType == "article" %}"BlogPosting"{% else %}"WebPage"{% endif %},
        "@id": {{ (canonicalUrl ~ "#webpage") | dump | safe }},
        "url": {{ canonicalUrl | dump | safe }},
        "name": {{ pageTitle | dump | safe }},
        "description": {{ pageDescription | dump | safe }},
        "isPartOf": { "@id": {{ (site.url ~ "/#website") | dump | safe }} },
        "inLanguage": "en"{% if pageType == "article" and date %},
        "headline": {{ title | dump | safe }},
        "datePublished": {{ (date | isoDate) | dump | safe }}{% endif %}
      }
    ]
  }
  </script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header>
      <nav>
        <a href="/" class="site-title">Nine Lives Club</a>
        <div class="nav-links">
          <a href="/projects/"{% if page.url == "/projects/" %} class="active"{% endif %}>Projects</a>
          <a href="/writing/"{% if page.url == "/writing/" %} class="active"{% endif %}>Writing</a>
          <a href="/inspiration/"{% if page.url == "/inspiration/" %} class="active"{% endif %}>Inspiration</a>
          <a href="/gallery/"{% if page.url == "/gallery/" %} class="active"{% endif %}>Gallery</a>
          <a href="/about/"{% if page.url == "/about/" %} class="active"{% endif %}>About</a>
        </div>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer>
      <p>© 3026</p>
    </footer>
  </div>
</body>
</html>
